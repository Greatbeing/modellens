# /etc/modellens/proxy.env — optional overrides for modellens-proxy.service.
# The defaults passed on the ExecStart line already point at
# /etc/modellens/config.json and /var/lib/modellens/history.json.
#
# MODELLENS_CONFIG=/etc/modellens/config.json
# MODELLENS_DATA=/var/lib/modellens/history.json
#
# Admin endpoints (/modellens/table|explain|health|metrics) are open on
# loopback; set a token if the proxy is reachable from elsewhere.
# The token is read from the `proxy.admin_token` key in config.json, not here.
